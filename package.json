{
  "name": "connect",
  "version": "0.1.0",
  "description": "Connecti monorepo for the fullstack project",
  "private": true,
  "workspaces": [
    "apps/*",
    "web/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @connecti/api\" \"npm run dev -w @connecti/web\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:api": "npm run dev -w @connecti/api",
    "dev:web": "npm run dev -w @connecti/web"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "react-hook-form": "^7.87.0",
    "react-router-dom": "^7.18.3",
    "react-spinners": "^0.17.0"
  }
}
