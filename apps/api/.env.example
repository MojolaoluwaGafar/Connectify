# NODE_ENV=development
# PORT=3001
# SOCKET_PORT=3002
# INTERNAL_SOCKET_SECRET=dev-internal-socket-secret
# Only needed in production if the API and socket process are deployed as
# separate services — set to the socket service's internal/private URL.
# SOCKET_INTERNAL_URL=http://connecti-socket.internal:3002
# CORS_ORIGIN=http://localhost:5173
# CLIENT_URL=http://localhost:5173
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/connecti?retryWrites=true&w=majority
# JWT_SECRET_KEY=dev-secret-change-me
# JWT_EXPIRES_IN=7d
# LOG_LEVEL=info
# GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# Location autocomplete. With a LocationIQ key it's the primary provider;
# without one (or if it fails) the keyless public Photon instance is used
# (fair-use only — self-host Photon and set GEOCODER_URL for heavy traffic).
# LOCATIONIQ_API_KEY=your_locationiq_key
# GEOCODER_URL=https://photon.komoot.io/api
# BREVO_API_KEY=your_brevo_api_key
# EMAIL_FROM=verified-sender@example.com
# APP_EMAIL=your-smtp-user
# APP_PASSWORD=your-smtp-password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
